#!/usr/bin/env bash
set -euo pipefail

KIT_DIR="git+https://github.com/qunm00/sbx-pi-kit.git"
C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'
C_RED=$'\033[31m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
C_YELLOW=$'\033[33m'
log() { printf '%s\n' "$*" >&2; }

FORCE_NEW=false
HELP=false
VERSION=false
CUSTOM_NAME=""
PI_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --new)      FORCE_NEW=true; shift;;
    --version|-v) VERSION=true; shift;;
    --name)     if [ $# -lt 2 ]; then log "${C_RED}error:${C_RST} --name requires a value"; exit 2; fi; CUSTOM_NAME="$2"; shift 2;;
    --name=*)   CUSTOM_NAME="${1#--name=}"; shift;;
    -h|--help)  HELP=true; shift;;
    --kit)      log "${C_RED}error:${C_RST} --kit was removed; pass the kit as the first positional argument (pi-sbx <kit> [dir])"; exit 2;;
    --)         shift; break;;
    *)          PI_ARGS+=("$1"); shift;;
  esac
done
# Remaining args: directory path(s)
# Empty arrays under `set -u` are "unbound" in bash 3.2 (macOS default), so
# always expand them with the ${arr[@]+"${arr[@]}"} form.
set -- ${PI_ARGS[@]+"${PI_ARGS[@]}"}

# First positional argument may be a sandbox kit ref (git URL, OCI ref, path).
# Everything after it is the workspace directory.
is_kit_ref() {
  case "$1" in
    *://*|*+*|*.git|*.zip|*.yaml|*.yml) return 0;;
  esac
  # A local kit directory, when a workspace dir was also given
  if [ $# -gt 1 ] && [ -f "$1/spec.yaml" -o -f "$1/spec.yml" ]; then
    return 0
  fi
  return 1
}
if [ $# -gt 0 ] && is_kit_ref "$@"; then
  KIT_DIR="$1"
  shift
fi

if $HELP; then
  echo "Usage: pi-sbx [--new] [--name <name>] [kit] [dir]"
  echo "  --new        Destroy and re-create the sandbox"
  echo "  --name NAME  Sandbox name (default: pi-sbx)"
  echo "  kit          Kit path, git URL, or OCI ref (default: $KIT_DIR)"
  echo "  dir          Workspace directory (default: current dir)"
  echo "              Ignored when PI_SBX_MOUNTS is set."
  echo ""
  echo "Environment:"
  echo "  PI_SBX_MOUNTS  Directories to mount, comma separated. Each entry is an"
  echo "                 absolute host path, mounted at the same path inside the"
  echo "                 sandbox. Append :ro for read-only. When set, these are"
  echo "                 the ONLY mounts and the current directory is not mounted."
  echo "                 When unset, the workspace directory is mounted instead."
  echo "                 Example: PI_SBX_MOUNTS=\"\$HOME/libs:ro,/Users/me/docs\""
  echo ""
  echo "  PI_SBX_SESSIONS  Host directory for persistent pi sessions, shared by"
  echo "                 every project. Mounted read-write automatically and used"
  echo "                 as PI_CODING_AGENT_SESSION_DIR. Default: ~/.pi-sbx"
  echo "                 Sessions land in <dir>/sessions."
  echo ""
  echo "Examples:"
  echo "  pi-sbx                              Mount current dir into the shared sandbox"
  echo "  PI_SBX_MOUNTS=~/a,~/b pi-sbx         Mount only ~/a and ~/b"
  echo "  pi-sbx --name spike                 Sandbox named 'spike' instead of pi-sbx"
  echo "  pi-sbx --new                        Force fresh sandbox"
  echo "  pi-sbx ../sbx-pi-kit ~/my-project  Use local kit checkout"
  exit 0
fi

# Mounts come from PI_SBX_MOUNTS: comma-separated absolute paths, optional
# :ro suffix. sbx mounts each at the same absolute path in the sandbox. When
# PI_SBX_MOUNTS is empty the workspace directory is mounted instead.
MOUNTS=()
parse_mounts() {
  local raw="$1" entry path mode
  local -a entries
  IFS=',' read -r -a entries <<< "$raw"
  for entry in ${entries[@]+"${entries[@]}"}; do
    entry="$(printf '%s' "$entry" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$entry" ] && continue
    # A leading ~/ is not expanded by the shell in an env var value.
    case "$entry" in
      "~/"*) entry="$HOME/${entry#\~/}";;
    esac
    mode="rw"
    case "$entry" in
      *:ro) path="${entry%:ro}"; mode="ro";;
      *:rw) path="${entry%:rw}"; mode="rw";;
      *)    path="$entry";;
    esac
    case "$path" in
      /*) ;;
      *) log "${C_RED}error:${C_RST} PI_SBX_MOUNTS entry must be an absolute path: $path"; exit 2;;
    esac
    case "$mode" in
      ro) MOUNTS+=("${path}:ro");;
      *)  MOUNTS+=("${path}");;
    esac
  done
}
parse_mounts "${PI_SBX_MOUNTS:-}"

mounts_str() {
  if [ ${#MOUNTS[@]} -eq 0 ]; then
    printf ''
  else
    printf '%s\n' ${MOUNTS[@]+"${MOUNTS[@]}"} | sort | tr '\n' ' ' | sed 's/ $//'
  fi
}

DRY_RUN="${PI_SBX_DRY_RUN:-0}"
run() {
  if [ "$DRY_RUN" = "1" ]; then
    log "${C_DIM}[dry-run]${C_RST} $(printf '%q ' "$@")"
    return 0
  fi
  "$@"
}

if ! command -v sbx >/dev/null 2>&1; then
  log "${C_RED}pi-sbx: sbx CLI not found. Install: brew install docker/tap/sbx${C_RST}"
  exit 1
fi

WORKDIR="$(cd "${1:-.}" && pwd)"

# PI_SBX_SESSIONS is the persistent host dir for the shared sandbox: sessions
# live in <dir>/sessions, and the recorded mount list in <dir>/sbx-mounts.
SESSIONS_BASE="${PI_SBX_SESSIONS:-$HOME/.pi-sbx}"
case "$SESSIONS_BASE" in
  "~/"*) SESSIONS_BASE="$HOME/${SESSIONS_BASE#\~/}";;
esac
SESSION_DIR="$SESSIONS_BASE/sessions"
MOUNTS_FILE="$SESSIONS_BASE/sbx-mounts"

# One sandbox serves every project, so the name is fixed unless overridden.
if [ -n "$CUSTOM_NAME" ]; then
  SANDBOX_NAME="$(printf '%s' "$CUSTOM_NAME" | tr -cd '[:alnum:]_-')"
  if [ -z "$SANDBOX_NAME" ]; then
    log "${C_RED}error:${C_RST} --name has no usable characters: $CUSTOM_NAME"
    exit 2
  fi
else
  SANDBOX_NAME="pi-sbx"
fi

# Sessions must survive sandbox recreation, so the host dir is always mounted
# rw, unless PI_SBX_MOUNTS already covers it (exact path or a parent dir).
if [ "${#MOUNTS[@]}" -eq 0 ]; then
  MOUNTS+=("$WORKDIR")
  WORKSPACE_MOUNTED=true
else
  WORKSPACE_MOUNTED=false
fi
sessions_mount_covered=false
for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
  mp="${m%:ro}"; mp="${mp%:rw}"
  case "$mp" in
    "$SESSIONS_BASE") sessions_mount_covered=true;;
    /*) case "$SESSIONS_BASE" in "$mp"/*) sessions_mount_covered=true;; esac;;
  esac
done
$sessions_mount_covered || MOUNTS+=("$SESSIONS_BASE")

if $VERSION; then
  if sbx ls 2>/dev/null | awk -v name="$SANDBOX_NAME" 'NR>1 && $1 == name {found=1} END {exit !found}'; then
    if [ "$DRY_RUN" = "1" ]; then
      log "${C_DIM}[dry-run]${C_RST} sbx exec $(printf '%q ' "$SANDBOX_NAME") pi --version"
      exit 0
    fi
    exec sbx exec "$SANDBOX_NAME" pi --version
  fi
  echo "pi-sbx: no sandbox named $SANDBOX_NAME"
  exit 0
fi

log "${C_BOLD}${C_CYAN}╭─ pi-sbx ───────────────────────────────────────╮${C_RST}"
if $WORKSPACE_MOUNTED; then
  log "${C_CYAN}│${C_RST} workspace : ${WORKDIR}"
else
  log "${C_CYAN}│${C_RST} workspace : (none, PI_SBX_MOUNTS is set)"
fi
log "${C_CYAN}│${C_RST} sandbox   : ${SANDBOX_NAME}"
log "${C_BOLD}${C_CYAN}╰────────────────────────────────────────────────╯${C_RST}"

if $FORCE_NEW; then
  log "${C_DIM}Removing existing sandbox '${SANDBOX_NAME}' (--new)${C_RST}"
  run sbx rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
fi

EXISTS=false
if sbx ls 2>/dev/null | awk -v name="$SANDBOX_NAME" 'NR>1 && $1 == name {found=1} END {exit !found}'; then
  EXISTS=true
fi

log "${C_DIM}Sandbox exists: $EXISTS${C_RST}"
for m in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
  case "$m" in
    *:ro) log "${C_DIM}  mount      : ${m%:ro} (ro)";;
    *)    log "${C_DIM}  mount      : ${m} (rw)";;
  esac
done

if $EXISTS; then
  # Mounts are fixed at create time, so an existing sandbox cannot gain one.
  # Warn when the requested list differs from the one recorded at create.
  CURRENT_MOUNTS="$(mounts_str)"
  RECORDED_MOUNTS=""
  [ -f "$MOUNTS_FILE" ] && RECORDED_MOUNTS="$(tr '\n' ' ' < "$MOUNTS_FILE" | sed 's/ $//')"
  if [ "$CURRENT_MOUNTS" != "$RECORDED_MOUNTS" ]; then
    log "${C_YELLOW}warning:${C_RST} mounts changed; sbx sets mounts at create time only."
    log "         re-run with --new to apply: ${C_BOLD}pi-sbx --new${C_RST}"
  fi
fi

if ! $EXISTS; then
  if [ "$DRY_RUN" != "1" ]; then
    mkdir -p "$SESSION_DIR"
  fi
  if ! run sbx create "$KIT_DIR" --name "$SANDBOX_NAME" \
       ${MOUNTS[@]+"${MOUNTS[@]}"} 2>&1; then
    log "${C_RED}pi-sbx: failed to create sandbox${C_RST}"
    exit 1
  fi
  mkdir -p "$SESSIONS_BASE"
  mounts_str > "$MOUNTS_FILE"
fi

sleep 2
# Redirect session storage to the persistent mount so sessions survive sandbox
# recreation (--new) and are shared by every project. The user namespace
# (~/.pi/agent/) stays ephemeral in the sandbox; only sessions land on the host.
#
# pi must start in the directory pi-sbx was launched from, not the workdir the
# sandbox was created with, because the shared sandbox is reused across
# projects. sbx exec has no workdir flag, so cd inside the sandbox. When the
# workspace is not mounted (PI_SBX_MOUNTS set) the directory does not exist
# there, so fall back to the home directory.
exec_pi() {
  sbx exec -it "$SANDBOX_NAME" \
    env PI_CODING_AGENT_SESSION_DIR="$SESSION_DIR" \
    sh -c 'cd "$1" 2>/dev/null || cd "$HOME" || cd /; shift; exec "$@"' \
    sh "$WORKDIR" pi --model opencode/space-bunny-free
}
if [ "$DRY_RUN" = "1" ]; then
  log "${C_DIM}[dry-run]${C_RST} sbx exec -it $(printf '%q ' "$SANDBOX_NAME") env PI_CODING_AGENT_SESSION_DIR=$SESSION_DIR sh -c $(printf '%q ' 'cd "$1" 2>/dev/null || cd "$HOME" || cd /; shift; exec "$@"') sh $WORKDIR pi --model opencode/space-bunny-free"
  exit 0
fi
exec_pi
# Can also be run with sbx run,
# exec sbx run "$KIT_DIR" --name "$SANDBOX_NAME" pi "$WORKDIR"